{
  "name": "exam-prep-lite",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "catalog": "node scripts/snapshot-materials.mjs",
    "check:sources": "node scripts/check-sources.mjs --live",
    "validate:sources": "node scripts/check-sources.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate:sources && npm run test && npm run build"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
